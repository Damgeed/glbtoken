# Required
NEW_API_BASE_URL=https://your-newapi-instance.example.com
NEW_API_ADMIN_TOKEN=set-this-after-deploying-new-api
DATABASE_URL=postgresql://user:pass@host:5432/glbtoken

# Auth
JWT_SECRET=replace-with-at-least-32-random-bytes
GLBTOKEN_SECRET=replace-with-a-different-32-byte-secret
ADMIN_API_KEY=replace-with-a-different-high-entropy-token
# Comma-separated verified emails allowed to become admin; empty disables bootstrap.
BOOTSTRAP_ADMIN_EMAILS=

# OAuth / Social Login (optional)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (for password reset, email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@glbtoken.com

# Payment (optional - set at least one)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTO_USDT_TRC20=
CRYPTO_USDT_ERC20=
CRYPTO_BTC=
CRYPTO_ETH=

# Fallback (only used if New API is not available)
FALLBACK_API_KEY=
FALLBACK_API_URL=

# Optional tuning (safe defaults if unset)
FRONTEND_URL=https://glbtoken.com
FORWARDED_ALLOW_IPS=            # Railway ingress proxy IPs (empty = trust no X-Forwarded-For)
TUNNEL_TOKEN=                   # Cloudflare Tunnel token; then disable Railway public networking
SECURITY_CLEANUP_DELETE_EXPIRED=false  # set true only after DB backup/review
ORG_MAX_MEMBERS=100
GHS_TO_USD_RATE=14.5
REFERRAL_REWARD_GT=2.0
REFERRAL_MIN_SPEND_TOKENS=1000
SIGNUP_BONUS_TOKENS=25000
NEWAPI_QUOTA_PER_USD=1000

# Server
PORT=8000
